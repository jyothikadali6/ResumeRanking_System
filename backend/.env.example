# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resume_ranker

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# spaCy
SPACY_MODEL=en_core_web_sm

# File storage
UPLOAD_DIR=uploads

# Scoring: weight of semantic similarity vs skill overlap (0..1)
SEMANTIC_WEIGHT=0.7
SKILL_WEIGHT=0.3

# Whether to use Ollama for re-ranking/reasoning (falls back gracefully if off)
USE_LLM=true
